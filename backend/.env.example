DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sports_betting
DATABASE_USER=postgres
DATABASE_PASSWORD=your_local_password
MODEL_DIRECTORY=build/sprint2-models

# Optional flags: default off; HTTP mode is for a loopback-bound demo only.
LOCAL_DEMO_HTTP=false
VIRTUAL_BETTING_ENABLED=false
AUTH_ASSESSMENT_ENABLED=false

# Enable after explicit quote-table setup and market-model training.
MODEL_ODDS_ENABLED=false
MODEL_ODDS_MARGIN=0.05

# Enable after explicit additive parlay-table setup; requires model odds.
PARLAYS_ENABLED=false

# Optional local demo provider polling; not a streaming score feed.
AUTO_REFRESH_ENABLED=false
AUTO_REFRESH_INTERVAL_SECONDS=120
